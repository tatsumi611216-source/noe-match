# APIキー設定の雛形。このファイルをコピーして sourcing/.env を作り、実キーを記入する。
#   cp .env.example .env
# .env は .gitignore 済み（コミットされない）。実キーは絶対にコミットしないこと。

# gBizINFO（経産省）法人情報API トークン
#   取得: https://info.gbiz.go.jp/api/ で無料登録 → Web API利用申請（数日でトークン発行）
#   企業マスタの補完（資本金・従業員数・業種・設立・所在地）に使用
GBIZINFO_API_TOKEN=YOUR_GBIZINFO_TOKEN_HERE

# EDINET（金融庁）API キー（Subscription-Key）
#   取得: https://api.edinet-fsa.go.jp/ で無料登録 → APIキー発行
#   上場企業の有価証券報告書→関係会社（子会社）構造の取得に使用
EDINET_API_KEY=YOUR_EDINET_KEY_HERE
